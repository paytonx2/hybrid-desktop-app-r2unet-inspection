# Copy this file to ".env" (same folder as main.py) and fill in your own values.
# ".env" is git-ignored on purpose — never commit real keys.

# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# A name to tell machines apart on the dashboard, e.g. "workstation-1"
DEVICE_ID=workstation-1
